        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const original = $('05 - Build WF-07 Input').first().json;\nconst result = $json || {};\nconst failed = (platform) => ({ platform, status: 'failed', success: false, attempt: 1, error_code: 'STAR_PUBLISHER_FAILED', error_message: 'Check the n8n execution and platform before retrying.' });\nconst records = Array.isArray(result.publication_records) && result.publication_records.length ? result.publication_records : original.platforms.map(failed);\nconst successes = records.filter((r) => r.success === true && r.status === 'published');\nconst finalStatus = successes.length === records.length ? 'published' : successes.length ? 'partially_published' : 'failed';\nreturn [{ json: { scheduled_post_id: original.scheduled_post_id, unit_id: original.unit_id, final_status: finalStatus, published_at: finalStatus === 'published' ? new Date().toISOString() : null, last_error: finalStatus === 'published' ? null : 'Review platform result before retrying', records } }];"
      },
      "id": "publisher-normalize",
      "name": "07 - Normalize Publication Result",
      "type": "n8n-nodes-base.code",

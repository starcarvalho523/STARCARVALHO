      "parameters": {
        "jsCode": "const claimed = $json;\nif (Array.isArray(claimed) && claimed.length === 0) return [];\nconst item = Array.isArray(claimed) ? claimed[0] : claimed;\nif (!item.id || !item.unit_id || item.content_type !== 'image' || !Array.isArray(item.platforms) || item.platforms.length === 0) throw new Error('STAR_CLAIM_INVALID');\nreturn [{ json: { scheduled_post_id: item.id, unit_id: item.unit_id, title: item.title, caption: item.caption, media_type: 'IMAGE', media_url: item.media_url, platforms: item.platforms, attempt: 1 } }];"
      },

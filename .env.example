NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Asaas stays fail-closed. Keep sandbox for development/QA.
# Production requires ALL of: ASAAS_ENVIRONMENT=production,
# ASAAS_LIVE_PAYMENTS_ENABLED=true, exact production API URL/key,
# webhook token, and the matching private Supabase runtime configuration.
# Customer IDs are created/reused per Star Carvalhos customer and stored privately.
ASAAS_ENVIRONMENT=sandbox
ASAAS_LIVE_PAYMENTS_ENABLED=false
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Efí Pix Sandbox / QA.
EFI_ENABLED=false
EFI_ENVIRONMENT=sandbox
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_BASE64=
EFI_PIX_KEY=
EFI_PAYEE_CODE=
EFI_WEBHOOK_FORWARD_SECRET=

# Efí Pix Production stays fail-closed unless ALL dedicated Production values
# exist, the explicit flag is true, runtime is Vercel Production on main, and
# the database PIX/QR/EFI capability is enabled. Keep the P12 certificate base64
# and client secret server-only. Never commit their real values.
EFI_PIX_PRODUCTION_ENABLED=false
EFI_PIX_PRODUCTION_CLIENT_ID=
EFI_PIX_PRODUCTION_CLIENT_SECRET=
EFI_PIX_PRODUCTION_CERTIFICATE_BASE64=
EFI_PIX_PRODUCTION_KEY=
EFI_PIX_PRODUCTION_PAYEE_CODE=

# Efí Pix public serverless webhook. Generate a long random secret server-side.
# The receiver requires both this HMAC query token and an allowed Efí source IP.
EFI_PIX_WEBHOOK_HMAC_SECRET=
EFI_PIX_WEBHOOK_ALLOWED_IPS=34.193.116.226

# Efí credit card Sandbox / QA browser tokenization.
NEXT_PUBLIC_EFI_ACCOUNT_IDENTIFIER=
EFI_CARD_CLIENT_ID=
EFI_CARD_CLIENT_SECRET=
EFI_CARD_NOTIFICATION_URL=

# Efí credit card Production remains fail-closed unless the explicit runtime
# flag is true AND the exact session/user has an unexpired database canary row.
# The account identifier is a public browser credential; client secret remains server-only.
NEXT_PUBLIC_EFI_PRODUCTION_ACCOUNT_IDENTIFIER=
EFI_CARD_PRODUCTION_CLIENT_ID=
EFI_CARD_PRODUCTION_CLIENT_SECRET=
EFI_CARD_PRODUCTION_NOTIFICATION_URL=
EFI_CARD_PRODUCTION_ENABLED=false

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Asaas stays fail-closed. Keep sandbox for development/QA.
# Production requires ALL of: ASAAS_ENVIRONMENT=production,
# ASAAS_LIVE_PAYMENTS_ENABLED=true, exact production API URL/key,
# webhook token, and the matching private Supabase runtime configuration.
# Customer IDs are created/reused per Star Carvalhos customer and stored privately.
ASAAS_ENVIRONMENT=sandbox
ASAAS_LIVE_PAYMENTS_ENABLED=false
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

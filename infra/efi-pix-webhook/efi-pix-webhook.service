[Unit]
Description=STAR CARVALHOS Efí Pix webhook forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/starcarvalho/efi-pix-webhook
EnvironmentFile=/etc/starcarvalho/efi-pix-webhook.env
ExecStart=/usr/bin/node /opt/starcarvalho/efi-pix-webhook/receiver.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target

server {
    listen 80;
    server_name __WEBHOOK_HOST__;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name __WEBHOOK_HOST__;

    ssl_certificate /etc/letsencrypt/live/__WEBHOOK_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__WEBHOOK_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Efí Production client-certificate chain.
    ssl_client_certificate /etc/nginx/efi/certificate-chain-prod.crt;
    ssl_verify_client off;
    ssl_verify_depth 3;

    location = /healthz {
        proxy_pass http://127.0.0.1:8787/healthz;
        proxy_set_header Host $host;
    }

    # Efí first validates that requests without its client certificate are rejected.
    location = /webhook {
        ssl_verify_client on;
        proxy_pass http://127.0.0.1:8787$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 64k;
    }

    # Efí sends actual callbacks to registered-url + /pix.
    location = /webhook/pix {
        ssl_verify_client on;
        proxy_pass http://127.0.0.1:8787$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 64k;
    }
}
